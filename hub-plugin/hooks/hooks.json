{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/ghostty/bin/ghostty-claude-start"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/ghostty/bin/ghostty-claude-ping"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "EnterWorktree|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/fetch-before-worktree.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*__(transitionJiraIssue|editJiraIssue|executeWrite)",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/ticket-guard.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.config/ghostty/bin/ghostty-claude-ping"
          }
        ]
      }
    ]
  }
}
