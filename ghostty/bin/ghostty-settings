#!/usr/bin/env bash
# The settings panel (viewer/settings/settings-view.ts) as an overlay, from
# Alt+S (layout.conf) or the rail's ⚙ button (hub/rail/rail.ts), sized by
# Settings' layout.settingsPercent.
#   ghostty-settings <client>        open it on that tmux client
#   ghostty-settings --panel         what runs inside the overlay

source "$(dirname "$(readlink -f "$0")")/ghostty-lib.sh"

if [[ $1 == --panel ]]; then
  run_panel Settings "$GHOSTTY_CONF/viewer/settings/settings-view.ts"
fi

overlay "$1" ghostty-settings --panel
