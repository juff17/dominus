#!/usr/bin/env bash
# Tickets (viewer/tickets/tickets-view.ts) as an overlay, from Alt+J
# (layout.conf): your team's sprint board, and agents started on its tickets.
#   ghostty-tickets <client> <layout session>          open it on that tmux client
#   ghostty-tickets --panel <client> <layout session>  what runs inside the overlay

source "$(dirname "$(readlink -f "$0")")/ghostty-lib.sh"

if [[ $1 == --panel ]]; then
  run_panel Tickets "$GHOSTTY_CONF/viewer/tickets/tickets-view.ts" "${@:2}"
fi

overlay "$1" ghostty-tickets --panel "$1" "${@:2}"
