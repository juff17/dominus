#!/usr/bin/env bash
# Alt+D: Claude's diagrams for one tab, in a window of their own over layout
# window <win> (dv, framed).
#   ghostty-diagrams <win> <tab session>   that session's active tab, followed
#                                          as it changes (ghostty-3, peek-12)
#   ghostty-diagrams <win> <%pane>         that one tab-server pane
#   ghostty-diagrams <win> job:<id> [title] that background job's, which has
#                                          no tab
# A window rather than a tmux popup: tmux drops the passthrough that dv draws
# its pictures with from a popup, and keeps it for a pane.

source "$(dirname "$(readlink -f "$0")")/ghostty-lib.sh"
win=$1 from=$2 title=${3:-}
session="layout-$win"
find_node || {
  layout display -t "$session:" "Diagrams need Node.js"
  exit 1
}
pick_title=()
if [[ $from == job:* ]]; then
  pick="DV_JOB=${from#job:}"
  pick_title=(-e "DV_TITLE=$title")
elif [[ $from == %* ]]; then
  pick="DV_PANE=$TABS_SOCKET:$from"
else
  pick="DV_TABS=$TABS_SOCKET:$from"
fi
popup_opens diagrams || {
  layout display -t "$session:" "Diagrams are off in Settings › Workspace"
  exit 0
}
# A second quick press runs this again before the first's window is made;
# it waits, so the first's window is there to go below.
window_lock "$win" diagrams
# One at a time: a diagrams window left open behind the others goes first.
layout kill-window -t "=$session:diagrams" 2>/dev/null
# The window you were in, which dv draws dimmed round its frame
# (tui/overlay.ts), and ghostty-backdrop draws while Node loads dv, which
# would otherwise show a blank window first.
under=$(layout display -p -t "$session:" '#{window_id}')
layout new-window -t "$session:" -n diagrams -e DV_FRAME=1 -e "$pick" "${pick_title[@]}" -e "OV_UNDER=$under" \
  "$GHOSTTY_CONF/bin/ghostty-backdrop" "$NODE" "$GHOSTTY_CONF/viewer/diagrams/diagram-view.ts" || {
  status=$?
  ah_log error diagrams "diagrams window not opened" exit "$status" win "$win"
  exit "$status"
}
