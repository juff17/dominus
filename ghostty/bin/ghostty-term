#!/usr/bin/env bash
# Ctrl+Shift+T in a background agent's session beside the hub (layout.conf).
# That agent has no tabs to add one to, so a terminal opens in a popup over
# the window, in the agent's folder. Esc closes it; Ctrl+Shift+T in it moves
# it to the workspace as a new tab and shows the workspace.
#   ghostty-term <client> <%pane>   open it on that client, in the folder of
#                                   the agent that pane shows
#   ghostty-term --tab <session>    what Ctrl+Shift+T runs inside it
#   ghostty-term --attach <session> <dir> <win>   what the popup runs
#
# The terminal is a session of its own on the tab server, term-<pane>, whose
# key table (popterm, tmux.conf) holds those two keys; every other key goes
# to the shell. Ghostty sends Ctrl+Shift+T as \e[9001~, which the layout
# server reads as User0 (user-keys[0]), and tmux drops a user key on its way
# into a popup. So while a terminal is open the layout server stops reading
# it as one, and the bytes reach the popup as they came.

source "$(dirname "$(readlink -f "$0")")/ghostty-lib.sh"

NEW_TAB=$'\e[9001~'

if [[ ${1:-} == --tab ]]; then
  name=$2
  # set and show take a pane, so the session is named as its current one's.
  win=$(tab_server show -qv -t "=$name:" @term_win 2>/dev/null)
  # Without -d the moved window is the workspace's active tab. The session,
  # left with no window, ends, and so does the popup attached to it.
  if [[ -z $win ]] || ! err=$(tab_server move-window -s "=$name:" -t "=ghostty-$win:" 2>&1); then
    ah_log error term "terminal not moved" id "$name" win "$win" err "${err:-no window number}"
    tab_server display -t "=$name:" "$(words shell.term.moveFailed win="$win")"
    exit 1
  fi
  ah_log info term "terminal moved to a tab" id "$name" win "$win"
  layout select-window -t "=layout-$win:work"
  exit 0
fi

# The popup's command line goes through the default shell, often zsh, where
# a word starting with = (as the tmux targets do) names a command's path.
# So it only names this script, which starts tmux itself. The popup's shell
# is outside tmux as far as the tab server knows: TMUX names the layout
# server, which would refuse a nested client.
#
# This client mustn't ask for extended keys, as tmux.conf has a tmux-256color
# terminal do (extkeys). The layout server reads \e[9001~, while it's no key
# of its own, as Alt+[ and then 9001~, and sends that Alt+[ in the extended
# form to a popup that asked for it: the bytes never come back together for
# the tab server to read as Ctrl+Shift+T. Asked for nothing, it sends them as
# they came. So the client names a terminal tmux.conf gives no features to,
# and takes the others itself (-T).
if [[ ${1:-} == --attach ]]; then
  name=$2 dir=$3 win=$4
  unset TMUX TMUX_PANE
  export TERM=screen-256color
  exec tmux -L "$TABS_SOCKET" -f "$GHOSTTY_CONF/tmux.conf" -T RGB,clipboard,hyperlinks,usstyle,focus,sync \
    new-session -A -s "$name" -c "$dir" \; \
    set -t "=$name:" key-table popterm \; set -t "=$name:" status off \; set -t "=$name:" @term_win "$win"
fi

client=$1 pane=$2
name="term-${pane#%}"
session_window "$(layout display -p -c "$client" '#{client_session}' 2>/dev/null)" layout- || {
  ah_log warn term "terminal not opened" client "$client" pane "$pane" reason "not in a layout window"
  exit 1
}
# The agent's folder as it is now: agentd's for the job the pane attaches to
# (state.json, agents/client.ts), since the agent may have moved since its
# session opened (into a worktree, or out of one that's gone). The folder
# the hub named on the pane when it opened (@peek_bg) stands in while
# agentd doesn't have the job, and the home folder when neither is there.
dir='' from=home
if [[ $(layout display -p -t "$pane" '#{pane_start_command}' 2>/dev/null) =~ ghostty-hub\ attach\ ([[:alnum:]_-]+) ]] && find_node; then
  job=${BASH_REMATCH[1]}
  dir=$("$NODE" -e '
    const [state, job] = process.argv.slice(1)
    const a = JSON.parse(require("node:fs").readFileSync(state, "utf8")).agents?.find(x => x.jobId === job)
    if (a?.cwd) console.log(a.cwd)' "${XDG_RUNTIME_DIR:-/tmp}/agent-hub/state.json" "$job" 2>/dev/null)
  [[ -d $dir ]] && from=agentd
fi
if [[ $from == home ]]; then
  dir=$(layout display -p -t "$pane" '#{@peek_bg}' 2>/dev/null)
  [[ -d $dir ]] && from=pane
fi
[[ $from == home ]] && dir=$HOME
ah_log info term "folder chosen" id "$name" job "${job:-}" dir "$dir" from "$from"

# Reads Ctrl+Shift+T as a key again once no terminal is open in any window.
restore() {
  tab_server list-sessions -F '#{session_name}' 2>/dev/null | grep -q '^term-' && return
  layout set -s 'user-keys[0]' "$NEW_TAB"
}
trap restore EXIT

key=$(setting keys.newTab '' ctrl+shift+t)
title=$(words shell.term.title dir="${dir/#"$HOME"/\~}" key="${key:-ctrl+shift+t}")
# tmux reads the title as a format, where # starts one.
title=${title//#/##}
layout set -su 'user-keys[0]'
cmd=$(printf '%q ' "$GHOSTTY_CONF/bin/ghostty-term" --attach "$name" "$dir" "$WIN")
ah_log info term "terminal opened" id "$name" win "$WIN" pane "$pane"
layout display-popup -c "$client" -E -w 80% -h 80% -b rounded -S "fg=$(layout show -gv @accent 2>/dev/null || echo default)" -T "$title" -d "$dir" "$cmd" || {
  status=$?
  ah_log error term "terminal popup failed" id "$name" exit "$status" client "$client"
  exit "$status"
}
ah_log info term "terminal closed" id "$name"
