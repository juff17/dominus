#!/usr/bin/env bash
# The todo list (viewer/todo/todo-view.ts) as an overlay, from Alt+T
# (layout.conf), over the workspace or the hub alike, sized by Settings'
# layout.todoWidth and todoHeight. It follows the window's tab session, like
# the viewer's Todo mode.
#   ghostty-todo-panel <client> <dir>        open it on that tmux client; the
#                                            list counts dir as "this repo"
#                                            until it reads the active tab
#   ghostty-todo-panel --panel <session>     what runs inside the overlay

source "$(dirname "$(readlink -f "$0")")/ghostty-lib.sh"

if [[ $1 == --panel ]]; then
  session_window "$2" layout- && export DV_TABS="$TABS_SOCKET:ghostty-$WIN"
  export TD_POPUP=1
  run_panel Todo "$GHOSTTY_CONF/viewer/todo/todo-view.ts" "$PWD"
fi

client=$1 dir=$2
if ! popup_opens todo; then
  layout display -c "$client" "Todo is off in Settings › Workspace"
  exit 0
fi
session=$(layout display -p -c "$client" '#{client_session}' 2>/dev/null)
overlay "$client" -d "$dir" ghostty-todo-panel --panel "$session"
