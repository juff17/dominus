#!/usr/bin/env bash
# What babysitters proposed, from Alt+A (layout.conf): Monitors
# (bin/ghostty-monitors) on the client's window, with the approvals panel
# open on the monitor whose proposal has waited longest, or on the one given.
#   ghostty-approvals <client> [id]     open Monitors on that tmux client, on that proposal

source "$(dirname "$(readlink -f "$0")")/ghostty-lib.sh"

session=$(layout display -p -c "$1" '#{client_session}' 2>/dev/null)
if [[ -n ${2:-} ]]; then
  exec "$GHOSTTY_CONF/bin/ghostty-monitors" "$1" "$session" --approval "$2"
fi
exec "$GHOSTTY_CONF/bin/ghostty-monitors" "$1" "$session" --approvals
