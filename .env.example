# Install copies this file to .env (kept to you alone, and ignored by git).
# Fill in the JIRA_ lines there for the Tickets popup (Alt+J). Only the hub's
# fetch reads them; Settings and the setup screen show whether each is set,
# never the value.

# Your site, like https://<site>.atlassian.net
JIRA_SITE=
# The Atlassian account the token belongs to
JIRA_EMAIL=
# A scoped, read-only API token, made at
# https://id.atlassian.com/manage-profile/security/api-tokens with these scopes:
#   read:jira-work  read:jira-user  read:project:jira
#   read:board-scope:jira-software  read:board-scope.admin:jira-software
#   read:sprint:jira-software  read:issue-details:jira  read:jql:jira
# Tokens expire within a year; Alt+J says when Jira refuses it.
JIRA_API_TOKEN=
# scoped (the default) or classic, for a token made without scopes
JIRA_TOKEN_KIND=scoped
